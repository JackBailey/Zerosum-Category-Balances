{
    "name": "Zerosum Category Balances",
    "description": "Tie categories to accounts in Zerosum",
    "version": "1.0",
    "manifest_version": 3,
    "background": {
        "service_worker": "background.js"
    },
    "permissions": ["storage", "tabs"],
    "content_scripts": [
        {
            "js": ["content.js"],
            "matches": ["https://my.zerosumapp.com/budget/*"],
            "run_at": "document_start"
        }
    ],
    "options_ui": {
        "page": "options.html"
    },
    "host_permissions": [
        "https://my.zerosumapp.com/budget/*",
        "https://api.zerosumapp.com/*",
    ],
    "optional_host_permissions": [
        "https://*/"
    ],
    "update_url": "https://raw.githubusercontent.com/JackBailey/Zerosum-Category-Balances/refs/heads/main/build/update.xml"
}
