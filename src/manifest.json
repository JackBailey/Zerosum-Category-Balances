{
    "name": "Zerosum Category Balances",
    "description": "Tie categories to accounts, to make the most of savings and keep a couple's money to ",
    "version": "1.0",
    "manifest_version": 3,
    "background": {
        "service_worker": "background.js"
    },
    "permissions": ["storage", "activeTab", "scripting", "tabs"],
    "content_scripts": [
        {
            "js": ["content.js"],
            "matches": ["https://my.zerosumapp.com/budget/*"],
            "run_at": "document_start"
        }
    ],
    "options_ui": {
        "page": "options.html"
    },
    "host_permissions": [
        "https://my.zerosumapp.com/budget/*",
        "https://api.zerosumapp.com/*",
        "https://gist.github.com/*",
        "https://gist.githubusercontent.com/*",
        "https://opengist.io/*",
        "https://paste.jck.cx/*"
    ]
}
